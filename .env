APP_ENV=dev
APP_NAME="Cluster Service"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=DEBUG

# JWT
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Users store
USERS_JSON_PATH=data/users.json

# Kubernetes
KUBECONFIG_BASE_PATH=data/kubeconfigs

# Deploy Service
DEPLOY_SERVICE_URL=http://localhost:8001
DEPLOY_SERVICE_TOKEN=
DEPLOY_SERVICE_USERNAME=cluster_proxy
DEPLOY_SERVICE_PASSWORD=cluster_proxy_dev_pw
# ── Dry-run (e2e pipeline testing) ────────────────────────────────────────────
# Replaces the outermost side-effecting collaborators (deploy-service client,
# Kubernetes client) with stubs while routing, auth and validation still run.
# Environment variable only — never a request field. Distinct from the
# per-request `drain.dry_run` body field, which is unrelated.
# Both sides are stubbed: no cluster is contacted, no kubeconfig is read, no
# deploy-service call is made and no deploy-service token is fetched.
DRY_RUN_MODE=false

# ── Provenance annotations (ADR 0002) ─────────────────────────────────────────
# PROVENANCE_ANNOTATION_PREFIX — the domain the service's own namespace
# annotations live under (<prefix>/created-by, …). Required, with deliberately
# no value here: this file is loaded in every environment, so a value would
# become a silent default. Set in .env.dev / .env.test, and by the operator in
# production; the service refuses to start without a valid one.
