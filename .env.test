APP_ENV=test
APP_NAME="Cluster Service"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=DEBUG

# JWT
SECRET_KEY=test-secret-key-for-testing-only-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5

# Users store — points to a test fixture during tests
USERS_JSON_PATH=tests/fixtures/users.json

# Deploy Service — mocked in tests, URL is a placeholder
DEPLOY_SERVICE_URL=http://localhost:8001
DEPLOY_SERVICE_TOKEN=test-deploy-service-token
# Dry-run is toggled per-test via monkeypatch + get_settings.cache_clear(),
# so the suite must start from the off state.
DRY_RUN_MODE=false
