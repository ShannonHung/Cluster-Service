APP_ENV=prod
APP_NAME="Cluster Service"
APP_VERSION="0.2.0"
DEBUG=false
LOG_LEVEL=INFO

# JWT — override with a strong secret in production!
SECRET_KEY=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Users store
USERS_JSON_PATH=data/users.json
# Dry-run MUST stay false here. create_app() refuses to start when
# DRY_RUN_MODE=true and APP_ENV=prod: every write path would become a silent
# no-op that still answers 200 — worse than an outage, because nothing alerts.
DRY_RUN_MODE=false

# ── Provenance annotations (ADR 0002) ─────────────────────────────────────────
# PROVENANCE_ANNOTATION_PREFIX is deliberately NOT set here: supply a domain your
# organisation controls through the deployment's environment (e.g. the pod's
# Secret/ConfigMap), such as PROVENANCE_ANNOTATION_PREFIX=cluster-service.acme.io.
# The service refuses to start without it. Every namespace it creates or
# relabels is stamped with it, and changing it later leaves old annotations behind.
